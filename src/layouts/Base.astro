---
// Fontlar self-host (Fontsource). Üçüncü taraf CDN yok.
// Archivo için standard.css: wght + wdth eksenlerinin İKİSİ de gelir.
// index.css yalnız wght yükler ve geniş kurulum sessizce çalışmaz.
import '@fontsource-variable/archivo/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/inter';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';

import { THEME_COLOR } from '../lib/brand';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { credits } from '../components/signature/credits';

interface Props {
  title: string;
  description: string;
  route: string;
  /** Sayfanın kendi zemini koyuysa gövdeye koyu yüzey sınıfı uygulanır. */
  surface?: 'light' | 'dark';
}

const { title, description, route, surface = 'light' } = Astro.props;
const canonical = new URL(route, Astro.site).href;

// ── İmza Sistemi, Katman 0: makine katmanı ──────────────────
// Yapımcı kredisi arama motorları için makine-okunur hâle gelir.
const ORG_KV = 'https://www.konutverse.com/#organization';
const ORG_AD = 'https://alisdijital.com/#organization';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_KV,
      name: 'Konutverse',
      url: 'https://www.konutverse.com',
      description: 'Emlak ve inşaat firmaları için 360° sanal daire turu.',
      areaServed: { '@type': 'Country', name: 'Türkiye' },
    },
    {
      '@type': 'Organization',
      '@id': ORG_AD,
      name: credits.maker.name,
      url: credits.maker.url,
      address: {
        '@type': 'PostalAddress',
        addressLocality: credits.maker.city,
        addressCountry: credits.maker.country,
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.konutverse.com/#website',
      url: 'https://www.konutverse.com',
      name: 'Konutverse',
      inLanguage: 'tr-TR',
      publisher: { '@id': ORG_KV },
      creator: { '@id': ORG_AD },
    },
    {
      '@type': 'WebPage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://www.konutverse.com/#website' },
      creator: { '@id': ORG_AD },
    },
  ],
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={THEME_COLOR} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Konutverse" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- İmza Sistemi · Katman 0 -->
    <meta name="author" content={credits.maker.name} />
    <link rel="author" href={credits.maker.url} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">İçeriğe atla</a>

    <Header current={route} />

    <slot name="rail" />

    <main id="main" class:list={[surface === 'dark' && 'on-dark-deep']}>
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/reveal.ts';
      import '../scripts/lenis-init.ts';
      import '../scripts/console-signature.ts';
    </script>
  </body>
</html>
