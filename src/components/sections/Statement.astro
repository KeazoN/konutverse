---
/**
 * Durup baktıran an. Metin uydurma değil: Konutverse'ün kendi
 * /about sayfasındaki cümle. Ürünün tezi tek cümlede.
 */
import { site } from '../../content/site';
---

<section class="stm on-sand">
  <div class="shell stm__inner">
    <span class="stm__quote" aria-hidden="true">“</span>
    <blockquote class="stm__body">
      <p class="stm__text display display--lg">{site.about.keyline}</p>
    </blockquote>
    <p class="tech stm__attr">Konutverse — ürünün çıkış noktası</p>
  </div>
</section>

<style>
  .stm { padding-block: clamp(var(--s-16), 10vw, var(--s-48)); }

  .stm__inner {
    position: relative;
    max-width: 1040px;
    text-align: center;
  }

  /* Dev tırnak — dekoratif, metnin arkasında */
  .stm__quote {
    position: absolute;
    top: -0.42em;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: clamp(96px, 18vw, 300px);
    line-height: 1;
    color: var(--brick);
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
  }

  .stm__body { margin: 0; }
  /* İTALİK YOK: Fraunces'in italik dosyası yüklenmiyor, tarayıcı
     sahte eğim üretiyordu ve ucuz duruyordu. Dik kesim zaten daha
     otoriter; tek dekoratif kullanım için +90 KB font yükü değmez. */
  .stm__text {
    position: relative;
    text-wrap: balance;
  }

  .stm__attr {
    margin-top: clamp(var(--s-6), 3vw, var(--s-10));
    color: var(--ink-3);
  }
</style>
