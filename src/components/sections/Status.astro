---
import { site } from '../../content/site';

const { status } = site.home;
---

<section class="status on-sand section">
  <div class="shell">
    <div class="status__head">
      <p class="tech eyebrow">{status.kicker}</p>
      <h2 class="status__title">{status.title}</h2>
      <span class="tech status__stamp num">{status.stamp}</span>
    </div>

    <dl class="status__grid">
      {status.metrics.map((m) => (
        <div class="status__cell">
          <dt class="tech status__label">{m.label}</dt>
          <dd class="status__value num">{String(m.value).padStart(2, '0')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .status__head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: clamp(var(--s-8), 4vw, var(--s-16));
  }
  .status__title { font-size: var(--t-h1); max-width: 22ch; }
  .status__stamp { color: var(--ink-3); }

  .status__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 2px solid var(--ink);
  }
  @media (max-width: 720px) { .status__grid { grid-template-columns: 1fr; } }

  .status__cell {
    display: flex;
    flex-direction: column-reverse;   /* sayı üstte görünür */
    justify-content: flex-end;
    gap: var(--s-3);
    padding: var(--s-10) var(--s-6) var(--s-10) 0;
    border-right: var(--hairline) solid var(--stone);
  }
  .status__cell:last-child { border-right: 0; }
  @media (max-width: 720px) {
    .status__cell {
      border-right: 0;
      border-bottom: var(--hairline) solid var(--stone);
      padding-right: 0;
    }
  }
  .status__value {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: var(--fraunces-display);
    font-weight: 600;
    font-size: var(--t-display-xl);
    line-height: 0.82;
    letter-spacing: var(--ls-display);
    color: var(--brick);
  }
  .status__label { color: var(--ink-2); }
</style>
