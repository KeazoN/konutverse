---
/** Sıfır dolgulu sicil sayısı. "1 firma" küçüklüğü saklanmaz,
 *  teknik kayıt biçiminde sunulur — şeffaf okunur, yetersiz değil.
 *
 *  <dl> içinde kullanılır: sarmalayıcı <div>'in DOĞRUDAN çocukları
 *  <dt> ve <dd> olmak zorunda (WCAG / axe definition-list kuralı).
 *  Görsel sıra column-reverse ile sayı-önce yapılır; DOM sırası
 *  semantik doğru kalır (terim önce, tanım sonra).                */
interface Props { value: number; label: string; }
const { value, label } = Astro.props;
const padded = String(value).padStart(2, '0');
---
<div class="metric">
  <dt class="tech metric__label">{label}</dt>
  <dd class="metric__value num">{padded}</dd>
</div>

<style>
  .metric {
    display: flex;
    flex-direction: column-reverse;   /* sayı üstte görünür */
    justify-content: flex-end;
    gap: var(--s-3);
  }

  .metric__value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-weight: 600;
    font-size: var(--t-display);
    line-height: 0.9;
    letter-spacing: var(--ls-display);
    color: var(--brick);   /* ≥24px — kontrast politikası uygun */
  }
  :global(.on-ink) .metric__value,
  :global(.on-ink) .metric__value { color: var(--brick-lit); }

  .metric__label { color: var(--text-3); }
</style>
