---
interface Props { kicker: string; title: string; lead?: string; }
const { kicker, title, lead } = Astro.props;
---

<header class="phead">
  <div class="shell">
    <p class="tech eyebrow">{kicker}</p>
    <h1 class="phead__title display display--lg">{title}</h1>
    {lead && <p class="lead phead__lead">{lead}</p>}
  </div>
</header>

<style>
  .phead {
    padding-block: clamp(var(--s-16), 7vw, var(--s-32))
                   clamp(var(--s-8), 4vw, var(--s-16));
  }
  .phead__title { max-width: 16ch; }
  .phead__lead { margin-top: var(--s-6); }
</style>
