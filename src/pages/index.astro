---
import Base from '../layouts/Base.astro';
import KotRayi from '../components/site/KotRayi.astro';
import Hero from '../components/sections/Hero.astro';
import { site } from '../content/site';
import { featuredProject, kotOf } from '../content/projects';

const { meta } = site.home;

// Kot rayı işaretleri — binanın gerçek kotlarından örneklenir
const railMarks = [11, 8, 5, 2, 0].map((i) => ({ kot: kotOf(i), id: `f${i}` }));
---

<Base title={meta.title} description={meta.description} route="/" surface="dark">
  <KotRayi slot="rail" marks={railMarks} />
  <Hero />
</Base>
