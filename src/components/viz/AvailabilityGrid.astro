---
/** Bir kattaki daire hücreleri. Her hücre klavye erişilebilir <button>. */
export type Unit = {
  id: string;
  status: 'free' | 'sold' | 'reserved';
  tourable: boolean;
  area?: number;
};

/**
 * WCAG 2.5.3 (Label in Name): erişilebilir ad, GÖRÜNÜR metni bitişik
 * bir alt dize olarak içermeli. Hücrede görünen 'A01 360°' olduğu için
 * aria-label de onunla başlar; açıklama arkadan gelir.
 */
interface Props { units: readonly Unit[]; floorLabel: string; floorIndex: number; }
const { units, floorLabel, floorIndex } = Astro.props;

const STATUS_TR = { free: 'boş', sold: 'satıldı', reserved: 'rezerve' } as const;
---

<div class="avail">
  {units.map((u) => (
    <button
      class:list={['avail__cell', `is-${u.status}`, u.tourable && 'is-tourable']}
      type="button"
      data-unit={u.id}
      data-floor={String(floorIndex)}
      data-floor-label={floorLabel}
      data-status={u.status}
      data-tourable={String(u.tourable)}
      data-area={u.area ? String(u.area) : undefined}
      aria-label={`${u.id} — ${floorLabel}, ${u.id} numaralı daire, ${STATUS_TR[u.status]}${u.tourable ? ', 360° turu var' : ''}`}
    >
      <span class="tech avail__id">{u.id}</span>
      {u.tourable && (
        <svg class="avail__tour" viewBox="0 0 24 16" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="1.6">
          <ellipse cx="12" cy="8" rx="10" ry="5.5" />
          <path d="M12 2.5 v11" opacity=".5" />
          <path d="M8.5 4.6 l-2.4 -1.4 l2.6 -1.2" />
        </svg>
      )}
    </button>
  ))}
</div>

<style>
  .avail { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px; }

  .avail__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-2);
    min-height: 58px;
    padding: var(--s-2) var(--s-3);
    border: var(--hairline) solid transparent;
    border-radius: var(--radius-structural);
    color: var(--paper);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      transform var(--dur-fast) var(--ease),
      filter var(--dur-fast) var(--ease);
  }
  .avail__cell:hover { filter: brightness(1.18); }
  .avail__cell:active { transform: translateY(1px); }

  /* Zeminler AA güvenli tonlar — beyaz metinle 6.3+ */
  .is-free     { background: var(--avail-free); }
  .is-sold     { background: var(--avail-sold); }
  .is-reserved { background: var(--avail-reserved); }

  /* Zeminler AA güvenli; metin tam güçte beyaz kalır. */
  .avail__id { color: var(--paper); }

  /* Gezilebilir daire — tuğla çerçeve, çizim işareti */
  .is-tourable { border-color: var(--brick); }
  /* 360° işareti METİN değil İKON: aria-hidden gerçekten etkili olur
     ve erişilebilir ad görünür metinle çakışmaz (WCAG 2.5.3). */
  .avail__tour {
    align-self: flex-end;
    width: 22px;
    height: 15px;
    color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .avail__cell:active { transform: none; }
  }
</style>
