---
/** İç sayfa başlığı — pafta antet bloğu. */
import SheetRule from '../ui/SheetRule.astro';

interface Props { kicker: string; title: string; lead?: string; no?: string; }
const { kicker, title, lead, no = '01' } = Astro.props;
---

<header class="phead">
  <div class="shell shell--railed">
    <SheetRule no={`. ${no}`} kicker={kicker} />
    <h1 class="phead__title">{title}</h1>
    {lead && <p class="phead__lead">{lead}</p>}
  </div>
</header>

<style>
  .phead {
    padding-block: clamp(var(--s-16), 8vw, var(--s-32)) clamp(var(--s-8), 4vw, var(--s-16));
  }
  .phead__title {
    font-size: var(--t-display);
    letter-spacing: var(--ls-display);
    max-width: 18ch;
    margin-block: var(--s-8) 0;
  }
  .phead__lead {
    margin-top: var(--s-6);
    max-width: 58ch;
    font-size: clamp(var(--t-small), 1.15vw, 19px);
    color: var(--text-2);
  }
</style>
