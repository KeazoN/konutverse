---
import { site } from '../../content/site';

const { steps } = site.home;
---

<section class="steps section">
  <div class="shell">
    <div class="steps__head">
      <p class="tech eyebrow">{steps.kicker}</p>
      <h2 class="steps__title display display--lg">{steps.title}</h2>
    </div>

    <ol class="steps__list">
      {steps.items.map((item, i) => (
        <li class="step reveal" style={`--reveal-delay:${i * 70}ms`}>
          <span class="tech step__no num">{item.no}</span>
          <h3 class="step__title">{item.title}</h3>
          <p class="step__body">{item.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps__head { margin-bottom: clamp(var(--s-12), 5vw, var(--s-20)); }
  .steps__title { max-width: 14ch; }

  .steps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gutter);
  }
  @media (max-width: 900px) { .steps__list { grid-template-columns: 1fr; } }

  .step {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: var(--s-6);
    border-top: 2px solid var(--ink);
  }
  .step__no { color: var(--brick); }
  .step__title { font-size: var(--t-h3); margin-top: var(--s-1); }
  .step__body { color: var(--ink-2); font-size: var(--t-small); }
</style>
