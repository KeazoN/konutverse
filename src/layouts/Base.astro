---
// Fontlar self-host (Fontsource). Üçüncü taraf CDN yok.
//
// ÜÇ SES, üç ayrı aile:
//   Fraunces        -> display (yüksek kontrastlı editoryal serif)
//   Instrument Sans -> gövde ve arayüz
//   IBM Plex Mono   -> teknik katman
//
// Önceki kurulum başlık ve gövdede aynı aileyi (Archivo) kullanıyordu;
// bu bir tasarım kararı değil performans taviziydi ve düz görünüyordu.
import '../styles/fonts.css';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import '../styles/motion.css';

import { ClientRouter } from 'astro:transitions';

import { THEME_COLOR } from '../lib/brand';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { credits } from '../components/signature/credits';

interface Props {
  title: string;
  description: string;
  route: string;
}

const { title, description, route } = Astro.props;
const canonical = new URL(route, Astro.site).href;

// ── İmza Sistemi, Katman 0: makine katmanı ──────────────────
// Yapımcı kredisi arama motorları için makine-okunur hâle gelir.
const ORG_KV = 'https://www.konutverse.com/#organization';
const ORG_AD = 'https://alisdijital.com/#organization';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_KV,
      name: 'Konutverse',
      url: 'https://www.konutverse.com',
      description: 'Emlak ve inşaat firmaları için 360° sanal daire turu.',
      areaServed: { '@type': 'Country', name: 'Türkiye' },
    },
    {
      '@type': 'Organization',
      '@id': ORG_AD,
      name: credits.maker.name,
      url: credits.maker.url,
      address: {
        '@type': 'PostalAddress',
        addressLocality: credits.maker.city,
        addressCountry: credits.maker.country,
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.konutverse.com/#website',
      url: 'https://www.konutverse.com',
      name: 'Konutverse',
      inLanguage: 'tr-TR',
      publisher: { '@id': ORG_KV },
      creator: { '@id': ORG_AD },
    },
    {
      '@type': 'WebPage',
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://www.konutverse.com/#website' },
      creator: { '@id': ORG_AD },
    },
  ],
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={THEME_COLOR} />

    <!-- İki Fraunces alt kümesi de ön yüklenir.
         Preload olmadan font ilk boyamadan sonra geliyor, metin yeniden
         sarıyor ve hero butonları zıplıyor (ölçülen CLS 0.108).
         latin-ext ŞART: Türkçe ş/ğ/İ harfleri orada; yalnız latin
         preload edildiğinde CLS 0.104'e geri dönüyor (ölçüldü). -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/fraunces-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/fonts/fraunces-latin-ext.woff2" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color={THEME_COLOR} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Konutverse" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- İmza Sistemi · Katman 0 -->
    <meta name="author" content={credits.maker.name} />
    <link rel="author" href={credits.maker.url} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/* Sayfalar arası yumuşak geçiş — tam sayfa yeniden boyama yok */}
    <ClientRouter />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">İçeriğe atla</a>

    <Header current={route} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/reveal.ts';
      import '../scripts/lenis-init.ts';
      import '../scripts/console-signature.ts';
    </script>
  </body>
</html>
