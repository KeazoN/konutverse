---
import { site } from '../../content/site';
import { featuredProject } from '../../content/projects';
import Button from '../ui/Button.astro';

const { hero } = site.home;
const p = featuredProject;
---

<section class="hero">
  <div class="hero__grid">

    <div class="hero__copy">
      <p class="tech eyebrow">{site.brand.tagline}</p>

      <h1 class="display display--hero hero__title">
        {hero.title.map((line, i) => (
          <>{i > 0 && ' '}<span class="hero__line">{line}</span></>
        ))}
      </h1>

      <p class="lead hero__lead">{hero.body}</p>

      <div class="hero__actions">
        <Button href={hero.cta.href} variant="primary" size="lg">{hero.cta.label}</Button>
        <Button href={site.ctaPrimary.href} variant="ghost" size="lg" arrow={false}>
          {site.ctaPrimary.label}
        </Button>
      </div>
    </div>

    <figure class="hero__figure">
      <div class="media hero__media">
        <img
          src="/img/hero-poster.jpg"
          alt="360° turla gezilebilen bir dairenin oturma odası"
          width="1920"
          height="1013"
          fetchpriority="high"
          decoding="async"
        />
        <span class="tech hero__badge">360° gezilebilir</span>
      </div>

      <figcaption class="hero__caption">
        <span class="tech hero__project">{p.name}</span>
        <span class="tech hero__meta">
          {p.floors} kat · {p.units} daire · {p.district}, {p.city}
        </span>
      </figcaption>
    </figure>

  </div>
</section>

<style>
  .hero { padding-top: clamp(var(--s-12), 6vw, var(--s-32)); }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(var(--s-8), 5vw, var(--s-24));
    /* Sol kolon kabuk içinde hizalı; sağdaki fotoğraf ekran kenarına taşar */
    padding-left: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
  }

  .hero__copy {
    max-width: 640px;
    padding-block: clamp(var(--s-8), 4vw, var(--s-20));
  }

  .hero__title { margin-bottom: var(--s-6); }
  .hero__line { display: block; }

  .hero__lead { margin-bottom: var(--s-10, 40px); max-width: 46ch; }

  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  /* ── Fotoğraf: hero'nun ağırlık merkezi ─────────────────────── */
  .hero__figure { margin: 0; }

  .hero__media {
    aspect-ratio: 4 / 3.9;
    box-shadow: var(--shadow-lift);
  }

  .hero__badge {
    position: absolute;
    left: var(--s-5);
    bottom: var(--s-5);
    background: var(--brick);
    color: var(--paper);
    padding: 8px 12px;
  }

  .hero__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    padding-top: var(--s-4);
  }
  .hero__project { color: var(--ink); }
  .hero__meta { color: var(--text-3); }

  @media (max-width: 900px) {
    .hero { padding-top: var(--s-8); }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--s-12);
      padding-left: var(--gutter);
      padding-right: var(--gutter);
    }
    .hero__copy { max-width: none; padding-block: 0; }
    .hero__media { aspect-ratio: 4 / 3; }
  }
</style>
