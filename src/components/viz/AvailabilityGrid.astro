---
/**
 * Bir kattaki daire hücreleri. Her hücre klavye erişilebilir <button>.
 *
 * Vurgu hiyerarşisi: GEZİLEBİLİR daireler öne çıkar — ürünün kendisi
 * onlar. Satılmış daireler geri çekilir. Durum, dolu blok yerine
 * küçük bir renk işaretiyle verilir; sayfa ısı haritasına dönmez.
 *
 * WCAG 2.5.3: erişilebilir ad görünür metinle (daire no) başlar.
 */
export type Unit = {
  id: string;
  status: 'free' | 'sold' | 'reserved';
  tourable: boolean;
  area?: number;
};

interface Props { units: readonly Unit[]; floorLabel: string; floorIndex: number; }
const { units, floorLabel, floorIndex } = Astro.props;

const STATUS_TR = { free: 'boş', sold: 'satıldı', reserved: 'rezerve' } as const;
---

<div class="avail">
  {units.map((u) => (
    <button
      class:list={['cell', `is-${u.status}`, u.tourable && 'is-tourable']}
      type="button"
      data-unit={u.id}
      data-floor={String(floorIndex)}
      data-floor-label={floorLabel}
      data-status={u.status}
      data-tourable={String(u.tourable)}
      data-area={u.area ? String(u.area) : undefined}
      aria-label={`${u.id} — ${floorLabel}, ${u.id} numaralı daire, ${STATUS_TR[u.status]}${u.tourable ? ', 360° turu var' : ''}`}
    >
      <span class="tech cell__id">{u.id}</span>
      <span class="cell__dot" aria-hidden="true"></span>

      {u.tourable && (
        <svg class="cell__tour" viewBox="0 0 24 16" aria-hidden="true"
             fill="none" stroke="currentColor" stroke-width="1.6">
          <ellipse cx="12" cy="8" rx="10" ry="5.5" />
          <path d="M12 2.5 v11" opacity=".45" />
          <path d="M8.5 4.6 l-2.4 -1.4 l2.6 -1.2" />
        </svg>
      )}
    </button>
  ))}
</div>

<style>
  .avail { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-2); }

  .cell {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 54px;
    padding: var(--s-3) var(--s-4);
    background: var(--paper);
    border: var(--hairline) solid var(--stone);
    border-radius: var(--radius-structural);
    color: var(--ink-2);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .cell:hover { border-color: var(--ink); color: var(--ink); }

  .cell__id { letter-spacing: 0.06em; }

  /* Durum: dolu blok değil, küçük işaret */
  .cell__dot {
    width: 8px;
    height: 8px;
    margin-left: auto;
    flex: none;
    border-radius: var(--radius-pill);
  }
  .is-free     .cell__dot { background: var(--avail-free); }
  .is-reserved .cell__dot { background: var(--avail-reserved); }
  .is-sold     .cell__dot { background: var(--avail-sold); }

  /* Satılmış daire geri çekilir — tıklanacak bir şey yok */
  .is-sold { background: var(--sand); color: var(--ink-3); }

  /* Gezilebilir daire ÖNE ÇIKAR — ürünün kendisi bu */
  .is-tourable {
    border-color: var(--brick);
    border-width: 2px;
    color: var(--ink);
    background: var(--brick-wash);
  }
  .is-tourable:hover { background: var(--paper); }
  .cell__tour { width: 22px; height: 15px; color: var(--brick); flex: none; }
  .is-tourable .cell__dot { display: none; }

  @media (max-width: 560px) {
    .avail { grid-template-columns: repeat(2, 1fr); }
  }
</style>
