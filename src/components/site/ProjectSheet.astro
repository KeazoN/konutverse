---
/** Proje kartı — fotoğraf önde, teknik künye altta.
 *  Emlak kartının işi arzu uyandırmak; çizim değil fotoğraf gösterir. */
import type { Project } from '../../content/projects';
import { formatPrice } from '../../content/projects';
import { site } from '../../content/site';
import ProgressGauge from '../viz/ProgressGauge.astro';
import Arrow from '../ui/Arrow.astro';
import Picture from '../ui/Picture.astro';

interface Props { project: Project; image: string; imageAlt: string; ratio: string; }
const { project: p, image, imageAlt, ratio } = Astro.props;
const u = site.search.units;
---

<article
  class="card reveal"
  data-project={p.slug}
  data-firm={p.firm}
  data-city={p.city}
  data-floors={String(p.floors)}
>
  <a class="card__link" href="/demo">
    <div class="media card__media">
      <Picture
        name={image}
        alt={imageAlt}
        small={560}
        large={1000}
        ratio={ratio}
        sizes="(max-width: 900px) 100vw, 45vw"
      />
      <span class="tech card__badge">{site.search.tourBadge}</span>
    </div>

    <div class="card__body">
      <p class="tech card__firm">{p.firm}</p>
      <h3 class="card__name">{p.name}</h3>
      <p class="tech card__loc">{p.district}, {p.city}</p>

      <p class="card__price">
        <span class="card__amount num">{formatPrice(p.priceFrom)} ₺</span>
        <span class="tech card__priceNote">{site.search.priceSuffix}</span>
      </p>

      <div class="card__gauge">
        <ProgressGauge label={p.stage} pct={p.stagePct} />
      </div>

      <dl class="card__stats">
        <div><dt class="card__stat num">{p.floors}</dt><dd class="tech">{u.floors}</dd></div>
        <div><dt class="card__stat num">{p.units}</dt><dd class="tech">{u.units}</dd></div>
        <div><dt class="card__stat card__stat--hot num">{p.tourable}</dt><dd class="tech">{u.tourable}</dd></div>
      </dl>

      <span class="tech card__cta">{site.search.startTour} <Arrow /></span>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--paper);
    border: var(--hairline) solid var(--stone);
    transition: box-shadow var(--dur-fast) var(--ease),
                transform var(--dur-fast) var(--ease);
  }
  .card:hover { box-shadow: var(--shadow-lift); transform: translateY(-2px); }

  .card__link { display: block; text-decoration: none; color: inherit; height: 100%; }


  .card__badge {
    position: absolute;
    top: var(--s-4);
    left: var(--s-4);
    background: var(--brick);
    color: var(--paper);
    padding: 7px 10px;
  }

  .card__body { padding: var(--s-6); display: grid; gap: var(--s-3); }

  .card__firm { color: var(--brick); }
  .card__name {
    font-size: var(--t-h2);
    letter-spacing: var(--ls-h);
    line-height: 1.05;
  }
  .card__loc { color: var(--ink-3); margin-top: calc(var(--s-2) * -1); }

  .card__price { display: grid; gap: 2px; margin-top: var(--s-2); }
  .card__amount {
    font-family: var(--font-display);
    font-weight: 700;
    font-weight: 600;
    font-size: var(--t-h3);
  }
  .card__priceNote { color: var(--ink-3); }

  .card__gauge { margin-top: var(--s-2); }

  .card__stats {
    display: flex;
    gap: var(--s-8);
    margin: var(--s-2) 0 0;
    padding-top: var(--s-5);
    border-top: var(--hairline) solid var(--stone);
  }
  .card__stats div { display: grid; gap: 2px; }
  .card__stats dd { margin: 0; color: var(--ink-3); }
  .card__stat {
    font-family: var(--font-display);
    font-weight: 700;
    font-weight: 600;
    font-size: var(--t-h3);
    line-height: 1;
  }
  .card__stat--hot { color: var(--brick); }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-4);
    color: var(--brick);
  }
  .card:hover .card__cta :global(.arrow) { transform: translateX(4px); }
  .card__cta :global(.arrow) { transition: transform var(--dur-fast) var(--ease); }

  @media (prefers-reduced-motion: reduce) {
    .card:hover { transform: none; }
    .card:hover .card__cta :global(.arrow) { transform: none; }
  }
</style>
