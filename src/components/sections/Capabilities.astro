---
import { site } from '../../content/site';
import Button from '../ui/Button.astro';
import Picture from '../ui/Picture.astro';

const items = site.home.capabilities;

/** Her kabiliyet gerçek bir daire fotoğrafıyla eşlenir. */
const MEDIA = [
  { name: 'living',  ratio: '1000/667', alt: 'Oturma odası — 360° turda gezilebilen daire' },
  { name: 'kitchen', ratio: '1000/667', alt: 'Mutfak — 360° turda gezilebilen daire' },
  { name: 'bedroom', ratio: '1000/667', alt: 'Yatak odası — 360° turda gezilebilen daire' },
];
---

<section class="caps on-sand" id="nasil">
  <div class="shell">
    {items.map((item, i) => (
      <article class="cap reveal" style={`--reveal-delay:${i * 60}ms`}>
        <div class="cap__copy">
          <p class="tech eyebrow">{item.kicker}</p>
          <h2 class="cap__title">
            {item.title.map((line, j) => (
              <>{j > 0 && ' '}<span class="cap__line">{line}</span></>
            ))}
          </h2>
          <p class="cap__body">{item.body}</p>
          <Button href={item.cta.href} variant="quiet">{item.cta.label}</Button>
        </div>

        <div class="media cap__media">
          <Picture
            name={MEDIA[i].name}
            alt={MEDIA[i].alt}
            small={560}
            large={1000}
            ratio={MEDIA[i].ratio}
            sizes="(max-width: 900px) 100vw, 58vw"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <span class="tech cap__no num">{item.no}</span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* Metin kartı görselin üstüne biner: derinlik ve "tasarlanmış"
     hissi verir; şablon gibi durmaz. */
  .cap {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    padding-block: clamp(var(--s-16), 7vw, var(--s-32));
  }

  .cap__copy {
    grid-row: 1;
    grid-column: 1 / span 5;
    z-index: 1;
    background: var(--paper);
    padding: clamp(var(--s-6), 3vw, var(--s-12));
    box-shadow: var(--shadow-soft);
  }
  .cap__media {
    grid-row: 1;
    grid-column: 5 / span 8;
  }

  /* Çift sıralarda taraf değişir */
  .cap:nth-child(even) .cap__copy { grid-column: 8 / span 5; }
  .cap:nth-child(even) .cap__media { grid-column: 1 / span 8; }

  @media (max-width: 900px) {
    .cap {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: var(--s-10) var(--s-12);
    }
    .cap__copy,
    .cap:nth-child(even) .cap__copy {
      grid-row: 2;
      grid-column: 1;
      /* Kart görselin altından yukarı biner — masaüstündeki
         üst üste binme fikri telefonda da korunur */
      margin: calc(var(--s-10) * -1) var(--s-3) 0;
      padding: var(--s-6);
      box-shadow: var(--shadow-lift);
    }
    .cap__media,
    .cap:nth-child(even) .cap__media { grid-row: 1; grid-column: 1; }

  }

  .cap__title {
    font-size: var(--t-h1);
    letter-spacing: var(--ls-h);
    margin-bottom: var(--s-5);
  }
  .cap__line { display: block; }

  .cap__body {
    color: var(--ink-2);
    font-size: var(--t-lead);
    line-height: 1.55;
    max-width: 44ch;
    margin-bottom: var(--s-6);
  }



  .cap__no {
    position: absolute;
    top: var(--s-5);
    right: var(--s-5);
    background: var(--paper);
    color: var(--brick);
    padding: 8px 12px;
    font-size: var(--t-tech);
  }
</style>
