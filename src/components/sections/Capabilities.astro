---
import { site } from '../../content/site';
import Button from '../ui/Button.astro';

const items = site.home.capabilities;

/** Her kabiliyet gerçek bir daire fotoğrafıyla eşlenir. */
const MEDIA = [
  { src: '/img/living.jpg',  w: 1920, h: 1694, alt: 'Oturma odası — 360° turda gezilebilen daire' },
  { src: '/img/kitchen.jpg', w: 1920, h: 1151, alt: 'Mutfak — 360° turda gezilebilen daire' },
  { src: '/img/bedroom.jpg', w: 1920, h: 1280, alt: 'Yatak odası — 360° turda gezilebilen daire' },
];
---

<section class="caps section" id="nasil">
  <div class="shell">
    {items.map((item, i) => (
      <article class="cap reveal" style={`--reveal-delay:${i * 60}ms`}>
        <div class="cap__copy">
          <p class="tech eyebrow">{item.kicker}</p>
          <h2 class="cap__title">
            {item.title.map((line, j) => (
              <>{j > 0 && ' '}<span class="cap__line">{line}</span></>
            ))}
          </h2>
          <p class="cap__body">{item.body}</p>
          <Button href={item.cta.href} variant="quiet">{item.cta.label}</Button>
        </div>

        <div class="media cap__media">
          <img
            src={MEDIA[i].src}
            alt={MEDIA[i].alt}
            width={MEDIA[i].w}
            height={MEDIA[i].h}
            loading="lazy"
            decoding="async"
          />
          <span class="tech cap__no num">{item.no}</span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .cap {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(var(--s-8), 5vw, var(--s-24));
    padding-block: clamp(var(--s-12), 5vw, var(--s-24));
  }
  /* Çift sıralarda görsel sola geçer — ritim */
  .cap:nth-child(even) .cap__media { order: -1; }

  @media (max-width: 900px) {
    .cap { grid-template-columns: 1fr; gap: var(--s-8); }
    .cap:nth-child(even) .cap__media { order: 0; }
  }

  .cap__title {
    font-size: var(--t-h1);
    letter-spacing: var(--ls-h);
    margin-bottom: var(--s-5);
  }
  .cap__line { display: block; }

  .cap__body {
    color: var(--ink-2);
    font-size: var(--t-lead);
    line-height: 1.55;
    max-width: 44ch;
    margin-bottom: var(--s-6);
  }

  .cap__media { aspect-ratio: 16 / 11; box-shadow: var(--shadow-soft); }

  .cap__no {
    position: absolute;
    top: var(--s-5);
    left: var(--s-5);
    background: var(--paper);
    color: var(--brick);
    padding: 8px 12px;
    font-size: var(--t-tech);
  }
</style>
