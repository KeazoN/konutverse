---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Status from '../components/sections/Status.astro';
import Steps from '../components/sections/Steps.astro';
import Cta from '../components/sections/Cta.astro';
import { site } from '../content/site';

const { meta } = site.home;
---

<Base title={meta.title} description={meta.description} route="/">
  <Hero />
  <Capabilities />
  <Status />
  <Steps />
  <Cta />
</Base>
