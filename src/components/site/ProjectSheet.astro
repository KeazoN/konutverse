---
/**
 * Proje kartı — pafta antet bloğu.
 * Açık sayfada koyu blueprint kart: çizim dili her zaman lacivert
 * zeminde yaşar, tıpkı gerçek ozalitte olduğu gibi.
 */
import type { Project } from '../../content/projects';
import { formatPrice } from '../../content/projects';
import { site } from '../../content/site';
import BuildingSection from '../viz/BuildingSection.astro';
import ProgressGauge from '../viz/ProgressGauge.astro';
import SheetLabel from '../ui/SheetLabel.astro';
import Arrow from '../ui/Arrow.astro';

interface Props { project: Project; }
const { project: p } = Astro.props;
const u = site.search.units;
---

<article
  class="psheet on-dark reveal"
  data-project={p.slug}
  data-firm={p.firm}
  data-city={p.city}
  data-floors={String(p.floors)}
>
  <header class="psheet__head">
    <span class="tech psheet__firm">{p.firm}</span>
    <SheetLabel text={site.search.tourBadge} tone="brick" />
  </header>

  <div class="psheet__body">
    <div class="psheet__figure" aria-hidden="true">
      <BuildingSection
        floors={p.floors}
        unitsPerFloor={4}
        tourableFloors={p.floors > 1 ? [0, 2] : [0]}
        label=""
      />
    </div>

    <div class="psheet__info">
      <h3 class="psheet__name">{p.name}</h3>
      <p class="tech psheet__loc">{p.district}, {p.city}</p>

      <p class="psheet__price">
        <span class="psheet__amount num">{formatPrice(p.priceFrom)} ₺</span>
        <span class="tech psheet__priceNote">{site.search.priceSuffix}</span>
      </p>

      <div class="psheet__gauge">
        <ProgressGauge label={p.stage} pct={p.stagePct} />
      </div>

      <dl class="psheet__stats">
        <div><dt class="psheet__stat num">{p.floors}</dt><dd class="tech">{u.floors}</dd></div>
        <div><dt class="psheet__stat num">{p.units}</dt><dd class="tech">{u.units}</dd></div>
        <div>
          <dt class="psheet__stat psheet__stat--hot num">{p.tourable}</dt>
          <dd class="tech">{u.tourable}</dd>
        </div>
      </dl>
    </div>
  </div>

  <a class="psheet__cta" href="/demo">
    <span class="tech">{site.search.startTour}</span>
    <Arrow />
  </a>
</article>

<style>
  .psheet {
    display: grid;
    grid-template-rows: auto 1fr auto;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-structural);
  }

  .psheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-6);
    border-bottom: var(--hairline) solid var(--line);
  }
  .psheet__firm { color: var(--brick-lit); }

  .psheet__body {
    display: grid;
    grid-template-columns: 108px 1fr;
    gap: var(--s-6);
    padding: var(--s-6);
    align-items: start;
  }
  @media (max-width: 520px) {
    .psheet__body { grid-template-columns: 84px 1fr; gap: var(--s-4); }
  }

  .psheet__figure { align-self: stretch; display: flex; align-items: flex-end; }
  .psheet__figure :global(svg) { max-height: 240px; width: 100%; }

  .psheet__info { display: grid; gap: var(--s-4); }

  .psheet__name {
    font-size: var(--t-h2);
    letter-spacing: var(--ls-h);
    line-height: 1.05;
  }
  .psheet__loc { opacity: 0.5; margin-top: calc(var(--s-2) * -1); }

  .psheet__price { display: grid; gap: 2px; }
  .psheet__amount {
    font-family: var(--font-display);
    font-stretch: var(--wdth-display);
    font-weight: 600;
    font-size: var(--t-h3);
    letter-spacing: var(--ls-h3);
  }
  .psheet__priceNote { opacity: 0.45; }

  .psheet__gauge { margin-top: var(--s-2); }

  .psheet__stats {
    display: flex;
    gap: var(--s-6);
    margin: var(--s-2) 0 0;
    padding-top: var(--s-4);
    border-top: var(--hairline) solid var(--line);
  }
  .psheet__stats div { display: grid; gap: 2px; }
  .psheet__stats dd { margin: 0; opacity: 0.5; }
  .psheet__stat {
    font-family: var(--font-display);
    font-stretch: var(--wdth-display);
    font-weight: 600;
    font-size: var(--t-h3);
    line-height: 1;
  }
  .psheet__stat--hot { color: var(--brick-lit); }

  .psheet__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-6);
    border-top: var(--hairline) solid var(--line);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .psheet__cta:hover { background: var(--ink-raised); color: var(--brick-lit); }
  .psheet__cta :global(.arrow) { transition: transform var(--dur-fast) var(--ease); }
  .psheet__cta:hover :global(.arrow) { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .psheet__cta:hover :global(.arrow) { transform: none; }
  }
</style>
