---
import { site } from '../../content/site';
import { featuredProject } from '../../content/projects';
import Button from '../ui/Button.astro';
import Picture from '../ui/Picture.astro';

const { hero } = site.home;
const p = featuredProject;
---

<section class="hero">
  <div class="hero__media">
    <Picture
      name="hero-poster"
      alt="360° turla gezilebilen bir dairenin oturma odası"
      small={900}
      large={1600}
      ratio="1600/900"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="shell hero__inner">
    <p class="tech hero__eyebrow">{site.brand.tagline}</p>

    <h1 class="display display--hero hero__title">
      {hero.title.map((line, i) => (
        <>{i > 0 && ' '}<span class="hero__line">{line}</span></>
      ))}
    </h1>

    <p class="hero__lead">{hero.body}</p>

    <div class="hero__actions">
      <Button href={hero.cta.href} variant="primary" size="lg">{hero.cta.label}</Button>
      <Button href={site.ctaPrimary.href} variant="onmedia" size="lg" arrow={false}>
        {site.ctaPrimary.label}
      </Button>
    </div>
  </div>

  <div class="hero__foot">
    <div class="shell hero__footRow">
      <span class="tech hero__badge">360° gezilebilir</span>
      <span class="tech hero__meta">
        {p.name} · {p.floors} kat · {p.units} daire · {p.district}, {p.city}
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(82svh, 820px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    color: var(--on-ink);
    overflow: hidden;
  }

  /* ── Fotoğraf ekranı doldurur — hero bir kutu değil, bir mekân ── */
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Kadraj aşağı kaydırılır: üstteki boş tavan yerine oturma grubu
       görünür. Hero'nun üst %40'ı ölü alandı. */
    object-position: center 68%;
  }

  /* Sıcak perde: metin okunur kalsın, fotoğraf boğulmasın */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      /* Üstte hafif katman: header ve fotoğrafın parlak kısmı çakışmasın */
      linear-gradient(
        to bottom,
        rgba(24, 20, 17, 0.30) 0%,
        rgba(24, 20, 17, 0.04) 20%,
        rgba(24, 20, 17, 0) 36%
      ),
      /* Altta metin bölgesi: neredeyse opak */
      linear-gradient(
        to top,
        rgba(24, 20, 17, 0.90) 0%,
        rgba(24, 20, 17, 0.74) 26%,
        rgba(24, 20, 17, 0.20) 54%,
        rgba(24, 20, 17, 0) 78%
      );
  }

  .hero__inner { padding-block: clamp(var(--s-12), 5vw, var(--s-20)) var(--s-6); }

  /* Fotoğrafın üstünde çıplak metin okunmuyordu (aydınlık duvar).
     Dolu şerit her kadrajda okunur ve kasıtlı görünür. */
  .hero__eyebrow {
    display: inline-block;
    background: var(--brick);
    color: var(--paper);
    padding: 8px 14px;
    margin-bottom: var(--s-6);
    white-space: nowrap;
  }

  .hero__title { color: var(--on-ink); max-width: 14ch; margin-bottom: var(--s-5); }
  .hero__line { display: block; }

  .hero__lead {
    margin-top: var(--s-5);
    max-width: 46ch;
    font-size: var(--t-lead);
    line-height: 1.55;
    color: var(--on-ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
  }

  /* ── Alt künye şeridi ─────────────────────────────────────── */
  .hero__foot {
    border-top: var(--hairline) solid rgba(252, 251, 249, 0.22);
    padding-block: var(--s-5);
  }
  .hero__footRow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
  }
  .hero__badge {
    background: var(--brick);
    color: var(--paper);
    padding: 7px 11px;
  }
  .hero__meta { color: rgba(252, 251, 249, 0.72); }

  @media (max-width: 720px) {
    /* Daha kısa hero: dikey kırpma azalır, oda görünür kalır.
       (3:5 dikey kadraj denendi — 16:9'dan dar bir dilim çıkıyor,
       odayı gösteremiyordu; yatay kadraj + kısa yükseklik daha iyi.) */
    .hero { min-height: min(74svh, 620px); }

    .hero__inner { padding-block: var(--s-8) var(--s-6); }

    /* Uzun etiket telefonda 3 satıra sarıyor ve fotoğrafın üstünde
       okunaksızlaşıyordu. Başlık zaten mesajı taşıyor; etiket
       dekoratif olduğu için dar ekranda gösterilmez. */
    .hero__eyebrow { display: none; }

    .hero__title { max-width: none; }
    .hero__lead { font-size: var(--t-body); max-width: none; }

    /* İki buton eşit ve tam genişlik — dağınık görünmüyor */
    .hero__actions { gap: var(--s-2); }
    .hero__actions > :global(.btn) { flex: 1 1 100%; justify-content: center; }

    .hero__footRow { gap: var(--s-3); }
    .hero__meta { font-size: 10px; line-height: 1.5; }
  }
</style>
