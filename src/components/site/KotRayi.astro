---
/** Sol kot rayı — bina kesitinin yükseklik cetveli.
 *  <1024px'te gizlenir; mobilde üst ilerleme rayı devralır. */
interface Props { marks: readonly { readonly kot: string; readonly id: string }[]; }
const { marks } = Astro.props;
---

<div class="kot" aria-hidden="true" data-kot-rail>
  <span class="tech kot__cap">KOT</span>
  <div class="kot__marks">
    {marks.map((m) => (
      <div class="kot__mark" data-kot={m.id}>
        <span class="tech kot__value num">{m.kot}</span>
        <span class="kot__tick"></span>
      </div>
    ))}
  </div>
</div>

<style>
  .kot { display: none; }

  @media (min-width: 1024px) {
    .kot {
      position: fixed;
      left: 0;
      top: 68px;              /* header yüksekliği */
      bottom: 0;
      width: var(--rail-w);
      z-index: 40;
      display: flex;
      flex-direction: column;
      gap: var(--s-6);
      padding: var(--s-8) var(--s-3) var(--s-12);
      border-right: var(--hairline) solid var(--line);
      pointer-events: none;
    }

    .kot__cap { color: var(--chalk-3); font-size: 9px; }

    .kot__marks {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .kot__mark { display: flex; align-items: center; gap: var(--s-2); }

    .kot__value {
      font-size: 9px;
      color: var(--chalk-3);
      transition: color var(--dur-fast) var(--ease);
    }

    .kot__tick {
      flex: 1;
      height: var(--hairline);
      background: var(--line);
      transition: background-color var(--dur-fast) var(--ease), height var(--dur-fast) var(--ease);
    }

    .kot__mark[data-active='true'] .kot__value { color: var(--brick-lit); }
    .kot__mark[data-active='true'] .kot__tick { background: var(--brick); height: 2px; }
  }
</style>
