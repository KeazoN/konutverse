---
import Arrow from './Arrow.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'quiet';
  size?: 'md' | 'lg';
  arrow?: boolean;
  external?: boolean;
}
const { href, variant = 'primary', size = 'md', arrow = true, external = false } = Astro.props;
---

<a
  class:list={['btn', `btn--${variant}`, `btn--${size}`]}
  href={href}
  rel={external ? 'noopener noreferrer' : undefined}
  target={external ? '_blank' : undefined}
>
  <span class="btn__label"><slot /></span>
  {arrow && <Arrow />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    border-radius: var(--radius-control);
    border: var(--hairline) solid transparent;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .btn__label {
    font-family: var(--font-tech);
    font-size: var(--t-tech);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--ls-tech);
    line-height: 1;
  }

  .btn :global(.arrow) { transition: transform var(--dur-fast) var(--ease); }
  .btn:hover :global(.arrow) { transform: translateX(4px); }

  .btn--md { padding: 14px 18px; }
  .btn--lg { padding: 19px 26px; }

  /* Birincil — tek dolu buton, sayfada bir tane */
  .btn--primary { background: var(--brick); color: var(--paper); }
  .btn--primary:hover { background: var(--brick-ink); }

  /* İkincil — sıcak çerçeve */
  .btn--ghost { border-color: var(--stone); color: var(--ink); }
  .btn--ghost:hover { border-color: var(--ink); }

  /* Üçüncül — sadece metin + alt çizgi */
  .btn--quiet {
    padding-inline: 0;
    color: var(--brick);
    box-shadow: 0 1px 0 currentColor;
  }
  .btn--quiet:hover { color: var(--brick-ink); }

  :global(.on-ink) .btn--ghost {
    border-color: rgba(252, 251, 249, 0.28);
    color: var(--on-ink);
  }
  :global(.on-ink) .btn--ghost:hover { border-color: var(--on-ink); }
  :global(.on-ink) .btn--quiet { color: var(--brick-lit); }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover :global(.arrow) { transform: none; }
  }
</style>
